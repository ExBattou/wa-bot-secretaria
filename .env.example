PORT=3000
GROQ_API_KEY=your_groq_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Modo de conexión del bot: 'true' para desarrollo local (long polling), 'false' para webhook
USE_POLLING=true
# Solo necesario si USE_POLLING=false (ej. en Railway/Render/VPS)
# TELEGRAM_WEBHOOK_URL=https://tu-dominio.com/webhook/telegram
DATA_PATH=./data
DATABASE_URL=postgresql://usuario:password@localhost:5432/karl_db
